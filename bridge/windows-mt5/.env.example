# Generate a long random value; never commit the real key.
MT5_BRIDGE_API_KEY=replace-with-long-random-secret

# Bind locally by default. A secure HTTPS tunnel/reverse proxy will be added separately.
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8765

# Optional explicit terminal path. Leave empty to let MetaTrader5 find the installed terminal.
MT5_TERMINAL_PATH=

# Read-only bridge: this must remain false.
MT5_EXECUTION_ENABLED=false
